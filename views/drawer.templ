package views

import (
	"github.com/kvalv/shoplist/carts"
	"github.com/kvalv/shoplist/stores"
	"fmt"
)

templ CartDrawerPage(activeID string, choices []*carts.Cart) {
	<html data-theme="light">
		@Head()
		<body
			class="container"
			style="min-height: 100vh;"
			data-signals:newCartStore={ q(f("%d", stores.General)) }
		>
			<nav class="flex items-center gap-1 sticky top-0 z-10 bg-page shadow-down rounded-bottom p-1">
				<span class="fw-500 flex-grow">Carts</span>
				<button class="btn-icon" onclick="history.back()">
					@IconX()
				</button>
			</nav>
			<main class="container" style="padding: 16px;">
				<button
					class="drawer-cart-item"
					data-on:click="document.getElementById('new-cart-modal').showModal()"
				>
					<span class="flex items-center gap-1">
						@IconPlus()
						<span>New cart</span>
					</span>
				</button>
				<hr/>
				<div class="flex-col gap-half">
					for _, choice := range choices {
						<a
							href={ urlf("/%s", choice.ID) }
							class={ "drawer-cart-item", templ.KV("active", choice.ID == activeID) }
						>
							<span class="fw-500">{ choice.Name }</span>
							<span class="drawer-cart-meta">
								{ fmt.Sprintf("%d items", len(choice.Items)) }
								&middot;
								{ choice.CreatedAt.Format("Jan 2") }
							</span>
						</a>
					}
				</div>
			</main>
			@NewCartModal()
		</body>
	</html>
}

templ NewCartModal() {
	<dialog id="new-cart-modal" closedby="any">
		<article>
			<header>
				<form method="dialog">
					<button aria-label="Close" rel="prev"></button>
				</form>
				<p><strong>New cart</strong></p>
			</header>
			<label>
				Select store type
				<select data-bind="newCartStore">
					<option value={ f("%d", stores.General) }>General</option>
					<option value={ f("%d", stores.ClasOhlson) }>Clas Ohlson</option>
				</select>
			</label>
			<div class="flex-col">
				<button class="primary" data-on:click="@post('/new-cart')">Create</button>
			</div>
		</article>
	</dialog>
}
