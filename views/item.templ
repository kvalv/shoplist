package views

import "github.com/kvalv/shoplist/carts"
import "github.com/kvalv/shoplist/stores"
import "github.com/kvalv/shoplist/stores/clasohlson"
import "time"

templ CartItem(item *carts.Item, isShopping bool, s stores.Store) {
	<div
		id={ f("item-%s", item.ID) }
		class={ "border rounded-sm shadow-sm px-1", 
        templ.KV("p-1", !isShopping), 
        templ.KV("py-quarter", isShopping), 
        templ.KV("discarded", item.Discarded) }
		style="background:#fff"
	>
		if isShopping {
			@ShoppingItem(item, s)
		} else if s == stores.ClasOhlson {
			@ClasOhlsonItem(item, isShopping)
		} else {
			@ListItem(item, s)
		}
	</div>
}

templ ShoppingItem(item *carts.Item, s stores.Store) {
	<div class="flex items-center gap-1">
		<label
			class={ "flex items-center gap-1 flex-grow pointer", templ.KV("text-secondary", item.Checked) }
			style="min-width: 100px; margin: 0;"
		>
			<input
				data-on:click__prevent={ f("@post('/check?id=%s')", item.ID) }
				data-init={ f("el.checked = %t", item.Checked) }
				type="checkbox"
				style="margin: 0;"
				disabled?={ item.Discarded }
			/>
			if s == stores.ClasOhlson {
				if selected := item.Clas.Selected(); selected != nil {
					<div class="flex gap-2 items-center">
						<img src={ selected.Picture } alt={ selected.Name } class="img-thumb-lg"/>
						<div class="flex-col gap-half">
							{ selected.Name }
							<div class="text-xs flex gap-1">
								@Location(selected.Locations)
								@Availability(selected.Stock)
							</div>
						</div>
					</div>
				} else {
					{ item.Text }
				}
			} else {
				{ item.Text }
			}
		</label>
		if s == stores.ClasOhlson && item.Clas != nil && len(item.Clas.Candidates) > 0 && item.Clas.Selected() == nil {
			<button class="btn-icon" onclick="">
				@IconWarning()
			</button>
		}
		<button
			class="btn-icon btn-icon-sm text-secondary"
			data-on:click={ f("document.getElementById('discard-%s').showModal()", item.ID) }
			disabled?={ item.Discarded }
		>
			@IconX()
		</button>
	</div>
	@DiscardModal(item.ID)
}

templ ListItem(item *carts.Item, s stores.Store) {
	<div class="flex items-center gap-1">
		<div class="flex-grow">
			<div class="fw-500">{ item.Text }</div>
			<div class="text-xs text-secondary">{ item.CreatedBy } &middot; { fmtTime(item.CreatedAt) }</div>
		</div>
		<button
			class="btn-icon btn-icon-sm text-secondary"
			data-on:click={ f("@post('/delete?id=%s')", item.ID) }
		>
			@IconX()
		</button>
	</div>
}

templ ClasOhlsonItem(item *carts.Item, isShopping bool) {
	<div class="flex items-center gap-1">
		<!-- Item content (left) -->
		<div
			class="flex-grow pointer"
			data-on:click={ f("document.getElementById('clas-%s').toggleAttribute('hidden')", item.ID) }
		>
			if selected := item.Clas.Selected(); selected != nil {
				<div class="flex gap-2 items-center">
					<img
						src={ selected.Picture }
						alt={ selected.Name }
						class="img-thumb-lg"
					/>
					<div class="flex-col gap-half">
						{ selected.Name }
						<div class="text-xs flex gap-1">
							@Price(selected.Price)
							@Availability(selected.Stock)
						</div>
					</div>
				</div>
			} else {
				<div class="flex gap-1 items-center">
					{ item.Text }
					if item.Clas != nil && len(item.Clas.Candidates) > 0 {
						<span class="text-warning">
							@IconWarning()
						</span>
					}
				</div>
			}
		</div>
		<!-- Actions (right) -->
		<details class="dropdown" style="margin: 0;">
			<summary role="button" class="outline secondary btn-icon">
				@IconDotsThreeVertical()
			</summary>
			<ul dir="rtl">
				<li>
					<a
						href="#"
						data-on:click__prevent={ f("@post('/not-found?id=%s')", item.ID) }
					>
						Fant ikke
					</a>
				</li>
				<li>
					<a
						href="#"
						data-on:click__prevent={ f("@post('/delete?id=%s')", item.ID) }
					>
						Delete
					</a>
				</li>
			</ul>
		</details>
	</div>
	<!-- Expandable candidates list -->
	if item.Clas != nil && len(item.Clas.Candidates) > 0 {
		<ul id={ f("clas-%s", item.ID) } class="flex-col gap-1 pl-2" hidden>
			for _, el := range item.Clas.Candidates {
				<li
					data-on:click={ f("@post('/select-clas-item?id=%s&clasId=%s')", item.ID, el.ID) }
					class={
						"flex gap-2 p-1 border-divider",
						templ.KV("border-success", item.Clas.Chosen == el.ID),
					}
				>
					<img
						src={ el.Picture }
						alt={ el.Name }
						class="img-thumb-lg"
					/>
					<div class="flex-col gap-half">
						{ el.Name }
						<div class="text-xs flex gap-1">
							@Price(el.Price)
							@Availability(el.Stock)
						</div>
					</div>
				</li>
			}
		</ul>
	}
}

templ Price(price float64) {
	<div class="">
		{ price } NOK
	</div>
}

templ Availability(qty int) {
	if qty > 5 {
		<div class="flex gap-half items-center text-secondary text-xs">
			<div aria-label="status" class="dot bg-success "></div>
			In stock
		</div>
	} else if qty > 0 && qty <= 5 {
		<div class="flex gap-half items-center text-secondary text-xs">
			<div aria-label="status" class="dot bg-warning "></div>
			{ f("%d in stock", qty) }
		</div>
	} else {
		<div class="flex gap-half items-center">
			<div aria-label="status" class="dot bg-error"></div>
			Out of stock
		</div>
	}
}

templ Location(locations []clasohlson.ShelfLocation) {
	if len(locations) > 0 {
		<span class="text-secondary">{ locations[0].Area } — { locations[0].Shelf }</span>
	} else {
		<span class="text-secondary">No location</span>
	}
}

templ DiscardModal(itemID string) {
	<dialog id={ f("discard-%s", itemID) } closedby="any">
		<article>
			<header>
				<form method="dialog">
					<button aria-label="Close" rel="prev"></button>
				</form>
				<p><strong>Discard item</strong></p>
			</header>
			<form method="dialog" class="flex-col gap-1">
				<button
					class="outline"
					data-on:click={ f("@post('/discard/%s/not_found')", itemID) }
				>
					Fant ikke
				</button>
				<button
					class="outline"
					data-on:click={ f("@post('/discard/%s/already_have')", itemID) }
				>
					Already have
				</button>
				<button
					class="outline"
					data-on:click={ f("@post('/discard/%s/wont_buy')", itemID) }
				>
					Kjøper ikke
				</button>
				<button
					class="secondary"
					data-on:click={ f("@post('/discard/%s/delete')", itemID) }
				>
					Delete
				</button>
			</form>
		</article>
	</dialog>
}

// 24x squared, some rounding on the border
templ Picture(src string, alt string) {
}

func fmtTime(t time.Time) string {
	return t.Format("02 Jan 15:04")
}
