package views

import (
	"github.com/kvalv/shoplist/carts"
	"fmt"
)

func itemText(item *carts.Item) string {
	if sel := item.Clas.Selected(); sel != nil {
		loc := "location unknown"
		if len(sel.Locations) > 0 {
			loc = sel.Locations[0].Shelf
		}
		return fmt.Sprintf("%s (hylle %s, %d in stock)", item.Text, loc, sel.Stock)
	}
	return item.Text
}

templ Cart(current *carts.Cart, choices []*carts.Cart, messages []*carts.Message, mode string) {
	if current == nil {
		return "current is nil"
	}
	<html id="foo" data-theme="light">
		@Head()
		<body
			id="body"
			data-init="@get('/render')"
			data-signals:current={ q(current.ID) }
			data-signals:mode__ifmissing={ q(mode) }
			class="container"
			style="min-height: 100vh; display: flex; flex-direction: column;"
		>
			@NavBar(current)
			<main class="container" style="flex: 1;">
				switch mode {
					case "list":
						@List(current.Items)
					case "shop":
						@Shop(current.Items)
					case "chat":
						@ChatHistory(current, messages)
				}
			</main>
			@Footer()
		</body>
	</html>
}

templ NavBar(current *carts.Cart) {
	<nav class="flex items-center gap-1 sticky top-0 z-10 bg-page shadow-down rounded-bottom p-1">
		<span
			class="fw-500 flex-grow"
			contenteditable="true"
			role="textbox"
			aria-label="Cart name"
			data-signals:name__ifmissing={ q(current.Name) }
			data-on:blur="$name = el.textContent.trim(); @post('/set-name')"
			data-on:keydown="if (event.key === 'Enter') { event.preventDefault(); el.blur() }"
		>{ current.Name }</span>
		<a href={ templ.SafeURL("/drawer?active=" + current.ID) } class="btn-icon">
			@IconHamburger()
		</a>
	</nav>
}

templ Footer() {
	<div class="sticky bottom-0 z-10 bg-page shadow-up rounded-top mb-0 p-1">
		@ChatInput()
	</div>
}

var f = fmt.Sprintf

// convenience function to quote, so we don't have to do { fmt.Sprintf(...) }
// all over the place.
func q(v any) string {
	switch concr := v.(type) {
	case string:
		return fmt.Sprintf("%q", concr)
	default:
		panic(fmt.Sprintf("quote: not implemented for %T", v))
	}
}
