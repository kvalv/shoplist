package views

import "github.com/kvalv/shoplist/carts"

func itemName(cart *carts.Cart, itemID *string) string {
	if cart == nil || itemID == nil {
		return ""
	}
	item := cart.Get(*itemID)
	if item == nil {
		return "@" + *itemID
	}
	if selected := item.Clas.Selected(); selected != nil {
		return "@" + selected.Name
	}
	return "@" + item.Text
}

templ ChatMessage(msg *carts.Message, cart *carts.Cart) {
	<div class="chat-bubble">
		<span class="chat-name"><span class="fw-600">{ derefOr(msg.UserID, string(msg.Role)) }</span> <span class="fw-300">{ msg.CreatedAt.Format("15:04") }</span></span>
		if msg.ItemID != nil {
			<span>{ msg.Text } <a href={ templ.SafeURL("#item-" + *msg.ItemID) } class="chat-chip">{ itemName(cart, msg.ItemID) }</a></span>
		} else {
			<span>{ msg.Text }</span>
		}
	</div>
}

func derefOr(p *string, fallback string) string {
	if p != nil {
		return *p
	}
	return fallback
}

templ ChatInput() {
	<div class="chat-toggle mb-1" data-on:change="history.replaceState(null, '', location.pathname + '?mode=' + $mode)">
		<label class="chat-toggle-item pointer flex items-center gap-half" data-class:chat-toggle-active="$mode === 'list'">
			<input type="radio" class="hidden" name="mode" value="list" data-bind:mode/>
			@IconList() List
		</label>
		<label class="chat-toggle-item pointer flex items-center gap-half" data-class:chat-toggle-active="$mode === 'chat'">
			<input type="radio" class="hidden" name="mode" value="chat" data-bind:mode/>
			@IconChatBubble() Chat
		</label>
		<label class="chat-toggle-item pointer flex items-center gap-half" data-class:chat-toggle-active="$mode === 'shop'">
			<input type="radio" class="hidden" name="mode" value="shop" data-bind:mode/>
			@IconShoppingCart() Shop
		</label>
	</div>
	<form class="form-chat flex gap-1" data-on:submit="@post('/add')">
		<input
			data-bind="msg"
			type="text"
			autocomplete="off"
			autofocus
			data-attr:placeholder="$mode === 'list' ? 'Add item' : 'Message...'"
		/>
		<button class="btn-icon" data-attr:disabled="$msg === ''" type="submit">
			@IconPlus()
		</button>
	</form>
}

templ Chat() {
	<div class="sticky bottom-0 z-10 bg-page shadow-up rounded-top mb-0 p-1">
		@ChatInput()
	</div>
}
