package views

import "github.com/kvalv/shoplist/carts"

func itemName(cart *carts.Cart, itemID *string) string {
	if cart == nil || itemID == nil {
		return ""
	}
	item := cart.Get(*itemID)
	if item == nil {
		return "@" + *itemID
	}
	if selected := item.Clas.Selected(); selected != nil {
		return "@" + selected.Name
	}
	return "@" + item.Text
}

templ ChatMessage(msg *carts.Message, cart *carts.Cart) {
	if msg.Role == carts.RoleSystem {
		<div class="chat-system">{ msg.Text } · { msg.CreatedAt.Format("15:04") }</div>
	} else if msg.Role == carts.RoleAssistant {
		<div class="chat-assistant">
			<span class="chat-assistant-name flex items-center gap-quarter">@IconSparkle() <span class="fw-600">Assistant</span> <span class="fw-300">{ msg.CreatedAt.Format("15:04") }</span></span>
			<span>{ msg.Text }</span>
		</div>
	} else {
		<div class="chat-bubble">
			<span class="chat-name flex items-center gap-half">
				if msg.UserPicture != nil {
					<img src={ *msg.UserPicture } class="chat-avatar" alt="" />
				} else {
					<span class="chat-avatar-placeholder">?</span>
				}
				<span class="fw-600">{ derefOr(msg.UserName, derefOr(msg.UserID, string(msg.Role))) }</span>
				<span class="fw-300">{ msg.CreatedAt.Format("15:04") }</span>
			</span>
			if msg.ItemID != nil {
				<span>{ msg.Text } <a href={ urlf("#item-%s", *msg.ItemID) } class="chat-chip">{ itemName(cart, msg.ItemID) }</a></span>
			} else {
				<span>{ msg.Text }</span>
			}
		</div>
	}
}

func derefOr(p *string, fallback string) string {
	if p != nil {
		return *p
	}
	return fallback
}

templ ChatHistory(cart *carts.Cart, messages []*carts.Message) {
	<div class="flex-col gap-half overflow-y-auto py-1" data-init="el.querySelector(':scope > :last-child')?.scrollIntoView({ behavior: 'instant', block: 'start' }); new MutationObserver(() => el.querySelector(':scope > :last-child')?.scrollIntoView({ behavior: 'smooth', block: 'start' })).observe(el, { childList: true })">
		for _, msg := range messages {
			@ChatMessage(msg, cart)
		}
	</div>
}

templ ChatInput(cartID string, mode string) {
	<div class="flex items-center mb-1">
		<div class="chat-toggle">
			<a href={ urlf("/%s/list", cartID) } class={ "chat-toggle-item pointer flex items-center gap-half", templ.KV("chat-toggle-active", mode == "list") }>
				@IconList()
				List
			</a>
			<a href={ urlf("/%s/chat", cartID) } class={ "chat-toggle-item pointer flex items-center gap-half", templ.KV("chat-toggle-active", mode == "chat") }>
				@IconChatBubble()
				Chat
			</a>
			<a href={ urlf("/%s/shop", cartID) } class={ "chat-toggle-item pointer flex items-center gap-half", templ.KV("chat-toggle-active", mode == "shop") }>
				@IconShoppingCart()
				Shop
			</a>
		</div>
		<div class="flex-grow"></div>
		<button
			class="btn-icon"
			data-on:click={ f("@post('/reorder/%s')", cartID) }
			aria-label="Reorder items"
		>
			@IconArrowsDownUp()
		</button>
	</div>
	<form class="form-chat flex gap-1" data-on:submit="@post('/add')">
		<input
			data-bind="msg"
			type="text"
			autocomplete="off"
			if mode == "list" {
				placeholder="Add item"
			} else {
				placeholder="Message..."
			}
		/>
		<button class="btn-icon" data-attr:disabled="$msg === ''" type="submit">
			@IconPlus()
		</button>
	</form>
}
