package views

import (
	"github.com/kvalv/shoplist/carts"
	"fmt"
	"github.com/kvalv/shoplist/stores"
)

func itemText(item *carts.Item) string {
	if sel := item.Clas.Selected(); sel != nil {
		loc := "location unknown"
		if len(sel.Locations) > 0 {
			loc = sel.Locations[0].Shelf
		}
		return fmt.Sprintf("%s (hylle %s, %d in stock)", item.Text, loc, sel.Stock)
	}
	return item.Text
}

templ cartList(items []*carts.Item) {
	<div data-show="$mode !== 'shop'" class="flex-col gap-1">
		for _, item := range items {
			@CartItem(item, false, stores.ClasOhlson)
		}
	</div>
	<div data-show="$mode === 'shop'" class="flex-col gap-1">
		for _, item := range items {
			@CartItem(item, true, stores.ClasOhlson)
		}
	</div>
}

templ Page(current *carts.Cart, choices []*carts.Cart, messages []*carts.Message, mode string) {
	if current == nil {
		return "current is nil"
	}
	<html id="foo" data-theme="light">
		<head>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.0-RC.7/bundles/datastar.js"></script>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link
				rel="stylesheet"
				href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.sand.min.css"
			/>
			<link rel="stylesheet" href="/static/styles.css?"/>
		</head>
		<body
			id="body"
			data-init="@get('/render')"
			data-signals:current={ q(current.ID) }
			data-signals:mode__ifmissing={ q(mode) }
			class="container"
			style="min-height: 100vh; display: flex; flex-direction: column;"
		>
			@NavBar(current)
			<main class="container" style="flex: 1; padding: 16px;">
				<div data-show="$mode !== 'chat'">
					@cartList(current.Items)
				</div>
				<div data-show="$mode === 'chat'" class="chat-messages-main flex-col gap-half" data-init="el.querySelector(':scope > :last-child')?.scrollIntoView({ behavior: 'instant', block: 'start' }); new MutationObserver(() => el.querySelector(':scope > :last-child')?.scrollIntoView({ behavior: 'smooth', block: 'start' })).observe(el, { childList: true })">
					for _, msg := range messages {
						@ChatMessage(msg, current)
					}
				</div>
			</main>
			@Chat()
		</body>
	</html>
}

templ NavBar(current *carts.Cart) {
	<nav class="flex items-center gap-1 sticky top-0 z-10 bg-page shadow-down rounded-bottom p-1">
		<span
			class="fw-500 flex-grow"
			contenteditable="true"
			role="textbox"
			aria-label="Cart name"
			data-signals:name__ifmissing={ q(current.Name) }
			data-on:blur="$name = el.textContent.trim(); @post('/set-name')"
			data-on:keydown="if (event.key === 'Enter') { event.preventDefault(); el.blur() }"
		>{ current.Name }</span>
		<a href={ templ.SafeURL("/drawer?active=" + current.ID) } class="btn-icon">
			@IconHamburger()
		</a>
	</nav>
}

var f = fmt.Sprintf

// convenience function to quote, so we don't have to do { fmt.Sprintf(...) }
// all over the place.
func q(v any) string {
	switch concr := v.(type) {
	case string:
		return fmt.Sprintf("%q", concr)
	default:
		panic(fmt.Sprintf("quote: not implemented for %T", v))
	}
}
