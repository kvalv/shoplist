package views

import "github.com/kvalv/shoplist/carts"
import "github.com/kvalv/shoplist/stores"

templ Shop(items []*carts.Item) {
	<div class="flex-col gap-half" data-init="let n = el.children.length; new MutationObserver(() => { if (el.children.length > n) window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }); n = el.children.length; }).observe(el, { childList: true })">
		for _, item := range items {
			@CartItem(item, true, stores.ClasOhlson)
		}
	</div>
}
